<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InteropSourceDirectory Condition="'$(InteropSourceDirectory)' == ''">$(MSBuildThisFileDirectory)../../../AAXClean.Codecs/Interop</InteropSourceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <Compile Include="$(InteropSourceDirectory)/NativeDecode.cs;$(InteropSourceDirectory)/NativeAacDecode.cs;$(InteropSourceDirectory)/NativeEc3Decode.cs;$(InteropSourceDirectory)/NativeAc4Decode.cs;$(InteropSourceDirectory)/NativeAacEncode.cs" Link="Interop/%(Filename)%(Extension)" />
    <Compile Include="../../../AAXClean.Codecs/FrameFilters/Audio/WaveFormat.cs" Link="Audio/%(Filename)%(Extension)" />
    <ProjectReference Include="../../../../../AAXClean/src/AAXClean/AAXClean.csproj" />
  </ItemGroup>
</Project>
